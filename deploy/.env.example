# Copy this to .env on the VPS:  cp .env.example .env  &&  chmod 600 .env
# Then edit values. NEVER commit the real .env to git.

# ─── Django Secrets ───
SECRET_KEY=replace-with-50-char-random-string
ALLOWED_HOSTS=mailsender.vvmtechnologies.com
CSRF_TRUSTED_ORIGINS=https://mailsender.vvmtechnologies.com

# ─── Database (PostgreSQL on same VPS) ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leadhunt
DB_USER=leadhunt
DB_PASSWORD=replace-with-strong-password

# ─── Sync API (this is the token your local PC uses to push data) ───
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNC_API_TOKEN=replace-with-random-48-char-token

# ─── Tracking links (auto-built from ALLOWED_HOSTS if blank) ───
TRACKING_BASE_URL=https://mailsender.vvmtechnologies.com

# ─── Optional: Error tracking ───
# Sign up at sentry.io (free for small teams)
# SENTRY_DSN=https://your-key@sentry.io/your-project

# ─── Gunicorn tuning (optional) ───
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=2
